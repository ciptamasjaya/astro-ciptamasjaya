---
/**
 * Post WordPress — URL dated dipertahankan persis: /YYYY/MM/DD/<slug>/
 * (keputusan SEO: tidak boleh 404, URL tidak berubah).
 */
import PageArticleLayout from '../../../../components/pages/PageArticleLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const p2 = (n: number) => String(n).padStart(2, '0');
  return articles
    .filter((a) => !a.data.draft)
    .map((article) => ({
      params: {
        year: String(article.data.pubDate.getUTCFullYear()),
        month: p2(article.data.pubDate.getUTCMonth() + 1),
        day: p2(article.data.pubDate.getUTCDate()),
        slug: article.data.slug,
      },
      props: { article },
    }));
}

const { article } = Astro.props;
---
<PageArticleLayout article={article} />
