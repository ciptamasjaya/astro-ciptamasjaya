---
/**
 * Kontak — halaman khusus dengan data kontak dari src/config.ts.
 * Struktur visual dan formulir ditangani oleh ContactPanel.
 */
import PageShell from '../components/shared/PageShell.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';
import ContactPanel from '../components/blocks/ContactPanel.astro';
import { site, services } from '../config';
import { breadcrumbSchema, localBusinessSchema } from '../utils/structured-data';

const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const schemas: object[] = [
  breadcrumbSchema([{ label: 'Beranda', href: '/' }, { label: 'Kontak' }], baseUrl),
  localBusinessSchema({ title: '', description: site.description, url: new URL('/contact/', baseUrl).toString() }),
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Kontak ${site.name}`, url: new URL('/contact/', baseUrl).toString() },
];
---
<PageShell title={`Kontak — ${site.name}`} description={`Hubungi ${site.name}: telepon ${site.phone}, WhatsApp ${site.phoneMobile}, email ${site.email}. Alamat: ${site.address.street}, ${site.address.locality}.`} canonical="/contact/">
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 md:py-12">
    <Breadcrumbs items={[{ label: 'Kontak' }]} />
    <ContactPanel
      id="contact-panel"
      title="Mari Berdiskusi tentang Kebutuhan K3 Anda"
      intro="Hubungi tim PT. Cipta Mas Jaya untuk membahas kebutuhan riksa uji, inspeksi, dan konsultasi keselamatan kerja. Kami siap membantu menentukan langkah yang sesuai dengan fasilitas Anda."
      contacts={[
        { label: 'Telepon', phone: site.phone.replace(/[^\d+]/g, ''), display: site.phone },
        { label: 'WhatsApp', phone: site.whatsapp, display: site.phoneMobile },
      ]}
      whatsapp={site.whatsapp}
      hoursTitle="Jam operasional"
      hours={['Senin–Jumat: 09.00–18.00 WIB', 'Sabtu–Minggu: Tutup']}
      formTitle="Ceritakan kebutuhan Anda"
      serviceOptions={[...services.map((s) => s.title), 'Lainnya']}
    />
    <section class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8" aria-labelledby="office-address-heading">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-xl text-blue-700 ring-1 ring-slate-200" aria-hidden="true">⌖</div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-blue-700">Lokasi kantor</p>
          <h2 id="office-address-heading" class="mt-2 text-xl font-bold text-slate-950">Kunjungi PT. Cipta Mas Jaya</h2>
          <address class="mt-3 not-italic leading-7 text-slate-600">
            {site.name}<br />
            {site.address.street}<br />
            {site.address.locality}, {site.address.region} {site.address.postalCode}
          </address>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a class="font-semibold text-blue-700 hover:text-blue-900 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" href={`mailto:${site.email}`}>Email: {site.email}</a>
            <a class="font-semibold text-blue-700 hover:text-blue-900 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>Telepon: {site.phone}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageShell>
