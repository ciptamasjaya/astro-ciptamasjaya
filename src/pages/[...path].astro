---
/** Halaman layanan generik (catch-all): /layanan/**, /tanya-jawab/**, sub-halaman WP lain. */
import WpPage from '../components/pages/WpPage.astro';
import RelatedArticles from '../components/shared/RelatedArticles.astro';
import { getCollection } from 'astro:content';
import { services } from '../config';

export async function getStaticPaths() {
  const [pages, articles] = await Promise.all([getCollection('pages'), getCollection('articles')]);
  return pages
    .filter((p) => !p.data.draft && !p.data.custom)
    .map((page) => ({
      params: { path: page.data.path.replace(/^\/+|\/+$/g, '') },
      props: { page, articles },
    }));
}

const { page, articles } = Astro.props;
const d = page.data;
const pathNorm = d.path.replace(/^\/+|\/+$/g, '');
const service = services.find((s) => s.path === pathNorm) ?? null;
---
<WpPage page={page} service={service ? { title: service.title, description: service.description, href: service.href } : null} />
{pathNorm.startsWith('layanan') && <RelatedArticles articles={articles} heading="Artikel Layanan Terkait" category={d.category} />}
