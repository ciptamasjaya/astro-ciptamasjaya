---
/** Halaman profil perusahaan /about/ dengan layout penuh dan konten berbasis blocks. */
import PageShell from '../components/shared/PageShell.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { getEntry } from 'astro:content';
import { breadcrumbSchema } from '../utils/structured-data';
import { site } from '../config';

const page = await getEntry('pages', 'about');
const d = page?.data;
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? new URL('/', Astro.url).origin;
const schemas = d ? [
  breadcrumbSchema([{ label: 'Beranda', href: '/' }, { label: d.title }], baseUrl),
] : [];
---
{page && d ? (
  <PageShell title={`${d.title} | ${site.name}`} description={d.description} canonical="/about/" image={d.image}>
    <Fragment slot="head">
      {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    </Fragment>
    <div>
      <div class="mx-auto max-w-7xl px-5 pt-6 sm:px-8">
        <Breadcrumbs items={[{ label: d.title }]} />
      </div>
      <header class="relative isolate overflow-hidden bg-slate-950 text-white">
        <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/60 via-slate-950 to-slate-950"></div>
        <div aria-hidden="true" class="absolute -right-20 -top-24 h-80 w-80 rounded-full border-[44px] border-white/[0.05] sm:h-[28rem] sm:w-[28rem]"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-[1fr_0.9fr] lg:gap-14 lg:py-20">
          <div class="max-w-3xl">
            <p class="inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-emerald-400"></span>
              Profil perusahaan · PJK3 · Riksa Uji
            </p>
            <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">Mengenal <span class="text-blue-300">Cipta Mas Jaya</span></h1>
            <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">{d.description}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/layanan/" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300">Jelajahi layanan <span class="ml-2" aria-hidden="true">→</span></a>
              <a href="/contact/" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/5 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Hubungi kami</a>
            </div>
          </div>
          {d.image && <div class="relative">
            <div aria-hidden="true" class="absolute -inset-3 rounded-3xl border border-blue-300/20"></div>
            <img src={d.image} alt="Kegiatan inspeksi K3 PT. Cipta Mas Jaya" class="relative aspect-[4/3] w-full rounded-2xl border border-white/15 object-cover shadow-2xl shadow-black/30" fetchpriority="high" />
          </div>}
        </div>
      </header>
      <BlockRenderer blocks={d.blocks ?? []} pageMetadata={{ title: d.title, description: d.description, image: d.image }} />
    </div>
  </PageShell>
) : null}
