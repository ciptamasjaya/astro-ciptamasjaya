---
/**
 * Halaman utama PT. Cipta Mas Jaya.
 * Penyegaran visual: hero editorial, fokus layanan, bukti kompetensi, artikel, dan CTA.
 */
import PageShell from '../components/shared/PageShell.astro';
import LatestArticlesBlock from '../components/blocks/LatestArticlesBlock.astro';
import CallToAction from '../components/blocks/CallToAction.astro';
import { site, services } from '../config';

const stats = [
  { value: '15+', label: 'Tahun pengalaman' },
  { value: '1.000+', label: 'Perusahaan terlayani' },
  { value: '6', label: 'Bidang riksa uji' },
  { value: 'PJK3', label: 'Layanan K3 profesional' },
];
---
<PageShell title={`${site.name} — PJK3 Riksa Uji dan Inspeksi K3`} description={site.description} canonical="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, description: site.description, url: Astro.site?.toString() })} />
  </Fragment>

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/50 via-slate-950 to-slate-950"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:px-8 md:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-emerald-400"></span>
          PJK3 · Riksa Uji · Inspeksi K3
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
          Keselamatan kerja dimulai dari <span class="text-blue-300">pemeriksaan yang tepat.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
          PT. Cipta Mas Jaya mendukung perusahaan melalui layanan riksa uji dan inspeksi K3 untuk membantu memastikan peralatan, instalasi, dan lingkungan kerja memenuhi persyaratan keselamatan yang berlaku.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/layanan/" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 focus:ring-offset-slate-950">
            Jelajahi layanan <span aria-hidden="true">→</span>
          </a>
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/25 bg-white/5 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-slate-950">
            Konsultasi melalui WhatsApp
          </a>
        </div>
        <p class="mt-5 text-xs leading-6 text-slate-400">Pendampingan untuk kebutuhan pemeriksaan dan pengujian K3 perusahaan Anda.</p>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div aria-hidden="true" class="absolute -inset-4 rounded-3xl border border-blue-300/15"></div>
        <div class="relative overflow-hidden rounded-2xl border border-white/15 bg-slate-800 shadow-2xl shadow-black/30">
          <img
            src="https://www.ciptamasjaya.co.id/wp-content/uploads/2024/09/tenaga-ahli-pjk3-riksa-uji-pt.cipta-mas-jaya-dengan-sertifikat-k3-pesawat-uap-dan-bejana-tekan-blending-tank.jpg"
            alt="Tenaga ahli PT. Cipta Mas Jaya dalam kegiatan riksa uji K3"
            class="aspect-[4/3] w-full object-cover"
            fetchpriority="high"
          />
          <div class="grid grid-cols-2 gap-px bg-white/15">
            <div class="bg-slate-900/95 p-4 sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-blue-200">Fokus utama</p>
              <p class="mt-1 text-sm font-bold text-white sm:text-base">Keselamatan operasional</p>
            </div>
            <div class="bg-slate-900/95 p-4 sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-blue-200">Pendekatan</p>
              <p class="mt-1 text-sm font-bold text-white sm:text-base">Inspeksi profesional</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Company facts -->
  <section aria-label="Profil singkat perusahaan" class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-slate-200 px-5 sm:px-8 md:grid-cols-4 md:divide-y-0">
      {stats.map((stat) => (
        <div class="px-4 py-7 text-center sm:px-6 sm:py-8">
          <p class="text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl">{stat.value}</p>
          <p class="mt-2 text-xs font-medium leading-5 text-slate-500 sm:text-sm">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 md:py-24" aria-labelledby="home-services-title">
    <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-700">Layanan kami</p>
        <h2 id="home-services-title" class="mt-3 max-w-xl text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl">
          Pemeriksaan K3 untuk mendukung tempat kerja yang lebih aman.
        </h2>
      </div>
      <div class="md:justify-self-end md:max-w-xl">
        <p class="text-base leading-7 text-slate-600">
          Temukan layanan pemeriksaan dan pengujian sesuai kebutuhan peralatan serta instalasi di tempat kerja Anda.
        </p>
        <a href="/layanan/" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900">
          Lihat seluruh layanan <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <a href={service.href} class="group flex min-h-48 flex-col rounded-xl border border-slate-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-slate-200/60 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-sm font-extrabold text-blue-700">{String(index + 1).padStart(2, '0')}</span>
            <span aria-hidden="true" class="text-xl text-slate-300 transition group-hover:translate-x-1 group-hover:text-blue-700">↗</span>
          </div>
          <h3 class="mt-6 text-lg font-bold leading-snug text-slate-900 group-hover:text-blue-800">{service.title}</h3>
          <span class="mt-3 text-sm font-semibold text-slate-500 group-hover:text-blue-700">Pelajari layanan</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Why CMJ -->
  <section class="bg-slate-50 py-16 md:py-20" aria-labelledby="home-approach-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-blue-700">Mitra perusahaan Anda</p>
        <h2 id="home-approach-title" class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl">
          Kejelasan proses. Fokus pada keselamatan.
        </h2>
        <p class="mt-5 text-base leading-7 text-slate-600">
          Riksa uji bukan sekadar pemeriksaan rutin. Proses yang tepat membantu perusahaan memahami kondisi peralatan, mengidentifikasi potensi risiko, dan menindaklanjuti kebutuhan keselamatan kerja.
        </p>
        <a href="/about/" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900">Kenali Cipta Mas Jaya <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-700">01 / Pemeriksaan</span>
          <h3 class="mt-3 text-lg font-bold text-slate-950">Berorientasi pada kondisi aktual</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Pemeriksaan disesuaikan dengan jenis peralatan dan ruang lingkup layanan.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-700">02 / Kepatuhan</span>
          <h3 class="mt-3 text-lg font-bold text-slate-950">Mendukung pemenuhan persyaratan</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Membantu perusahaan menindaklanjuti kebutuhan K3 sesuai ketentuan yang berlaku.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest articles -->
  <LatestArticlesBlock id="home-latest" title="Wawasan dan artikel K3 terbaru" limit={3} />

  <!-- CTA -->
  <CallToAction
    id="home-cta"
    title="Diskusikan kebutuhan riksa uji K3 Anda"
    description="Sampaikan jenis peralatan atau instalasi yang perlu diperiksa. Tim kami siap membantu Anda memahami layanan yang sesuai."
    primaryLabel="Lihat layanan"
    primaryHref="/layanan/"
    secondaryLabel="Konsultasi WhatsApp"
    secondaryHref=""
    secondaryIsWhatsApp={true}
  />
</PageShell>
