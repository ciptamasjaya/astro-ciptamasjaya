---
import ArticleH3 from './ArticleH3.astro';

interface Props {
  id: string;
  title: string;
  paragraphs: string[];
}
const { id, title, paragraphs } = Astro.props;
---
<section id={id} class="mt-8 border-l-2 border-slate-200 pl-4 sm:pl-6" aria-labelledby={`${id}-heading`}>
  <ArticleH3 id={`${id}-heading`} title={title} />
  <div class="space-y-4 text-base leading-8 text-slate-700 sm:text-[1.0625rem]">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
