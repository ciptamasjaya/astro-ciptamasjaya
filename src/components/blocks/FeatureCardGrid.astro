---
interface FeatureItem {
  title: string;
  description?: string;
  points?: string[];
}
interface Props {
  id: string;
  title: string;
  columns: 2 | 3;
  items: FeatureItem[];
}
const { id, title, columns, items } = Astro.props;
const titleId = `${id}-title`;
const gridClass = columns === 2 ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<section id={id} class="py-16 bg-gray-50" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id={titleId} class="text-2xl font-bold text-center text-gray-900 mb-12">{title}</h2>
    <div class={`grid gap-8 ${gridClass}`}>
      {items.map((item) => (
        <article class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-primary-600">{item.title}</h3>
          {item.description && <p class="text-gray-600 leading-relaxed">{item.description}</p>}
          {item.points && (
            <ul class="space-y-3 text-gray-600">
              {item.points.map((point) => <li class="flex items-start"><span class="text-primary-600 font-bold mr-2" aria-hidden="true">✓</span><span>{point}</span></li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
