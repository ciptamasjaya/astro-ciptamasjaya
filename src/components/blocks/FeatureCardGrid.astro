---
interface FeatureItem {
  title: string;
  description?: string;
  points?: string[];
  href?: string;
}
interface Props {
  id: string;
  title: string;
  columns: 2 | 3;
  items: FeatureItem[];
}
const { id, title, columns, items } = Astro.props;
const titleId = `${id}-title`;
const gridClass = columns === 2 ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<section id={id} class="py-16 bg-gray-50" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 id={titleId} class="text-2xl font-bold text-center text-gray-900 mb-12">{title}</h2>
    <div class={`grid gap-8 ${gridClass}`}>
      {items.map((item) => (
        <article class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md">
          <h3 class="mb-4 text-xl font-bold text-primary-600">
            {item.href ? <a href={item.href} class="rounded-sm hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">{item.title}</a> : item.title}
          </h3>
          {item.description && <p class="flex-1 leading-relaxed text-gray-600">{item.description}</p>}
          {item.points && (
            <ul class="space-y-3 text-gray-600">
              {item.points.map((point) => <li class="flex items-start"><span class="text-primary-600 font-bold mr-2" aria-hidden="true">✓</span><span>{point}</span></li>)}
            </ul>
          )}
          {item.href && <a href={item.href} class="mt-5 inline-flex items-center gap-2 self-start text-sm font-bold text-primary-600 hover:gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600">Baca selengkapnya <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
  </div>
</section>
