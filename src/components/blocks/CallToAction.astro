---
import { site } from '../../config';

interface Props {
  id: string;
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  secondaryIsWhatsApp?: boolean;
}
const { id, title, description, primaryLabel, primaryHref, secondaryLabel, secondaryHref, secondaryIsWhatsApp = false } = Astro.props;
const titleId = `${id}-title`;
const resolvedSecondaryHref = secondaryIsWhatsApp ? `https://wa.me/${site.whatsapp}` : secondaryHref;
---
<section id={id} class="bg-primary-50 py-16" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id={titleId} class="text-2xl font-bold text-primary-800 mb-6">{title}</h2>
    <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">{description}</p>
    <div class="flex flex-col sm:flex-row sm:justify-center space-y-4 sm:space-y-0 sm:space-x-4">
      <a href={primaryHref} class="px-6 py-3 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-primary-500">
        {primaryLabel}
      </a>
      <a href={resolvedSecondaryHref} class="px-6 py-3 bg-white text-primary-600 font-medium border border-primary-300 rounded-lg hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-primary-500">
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
