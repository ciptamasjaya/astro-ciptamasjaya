---
interface ContactNumber {
  label: string;
  phone: string;
  display: string;
}
interface Props {
  id: string;
  title: string;
  intro: string;
  contacts: ContactNumber[];
  hoursTitle: string;
  hours: string[];
  formTitle: string;
  serviceOptions: string[];
}
const { id, title, intro, contacts, hoursTitle, hours, formTitle, serviceOptions } = Astro.props;
const titleId = `${id}-title`;
const formId = `${id}-form`;
const primaryPhone = contacts[0]?.phone ?? '';
---
<section id={id} class="py-16 bg-white" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="text-center mb-12">
      <h1 id={titleId} class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">{title}</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{intro}</p>
    </header>
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Layanan Cepat via WhatsApp</h2>
          <div class="space-y-4">
            {contacts.map((contact) => (
              <a href={`https://wa.me/${contact.phone}`} target="_blank" rel="noopener noreferrer" class="block p-4 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors shadow-sm">
                <span class="font-bold text-lg">{contact.label}: {contact.display}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-200 space-y-4">
          <h2 class="text-xl font-bold text-gray-900">{hoursTitle}</h2>
          <ul class="space-y-2 text-sm text-gray-600">
            {hours.map((hour) => <li>{hour}</li>)}
          </ul>
        </div>
      </div>
      <div class="bg-gray-50 p-8 rounded-xl border border-gray-200">
        <h2 class="text-xl font-bold text-gray-900 mb-6">{formTitle}</h2>
        <form id={formId} data-contact-form data-whatsapp={primaryPhone} class="space-y-4">
          <div>
            <label for={`${formId}-name`} class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
            <input id={`${formId}-name`} name="name" type="text" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Nama Anda" />
          </div>
          <div>
            <label for={`${formId}-company`} class="block text-sm font-medium text-gray-700 mb-1">Nama Perusahaan</label>
            <input id={`${formId}-company`} name="company" type="text" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Nama perusahaan" />
          </div>
          <div>
            <label for={`${formId}-phone`} class="block text-sm font-medium text-gray-700 mb-1">Nomor WhatsApp / Telepon</label>
            <input id={`${formId}-phone`} name="phone" type="tel" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="08xxxxxxxxxx" />
          </div>
          <div>
            <label for={`${formId}-service`} class="block text-sm font-medium text-gray-700 mb-1">Pilih Layanan</label>
            <select id={`${formId}-service`} name="service" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500">
              {serviceOptions.map((service) => <option value={service}>{service}</option>)}
            </select>
          </div>
          <div>
            <label for={`${formId}-message`} class="block text-sm font-medium text-gray-700 mb-1">Pesan / Detail Kebutuhan</label>
            <textarea id={`${formId}-message`} name="message" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-primary-500 focus:border-primary-500" placeholder="Jelaskan kebutuhan atau kendala K3 Anda..."></textarea>
          </div>
          <button type="submit" class="w-full py-3 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition-colors shadow-sm">
            Lanjutkan ke WhatsApp
          </button>
          <p class="text-xs text-gray-500">Pesan akan disiapkan di WhatsApp; formulir ini tidak mengirim data ke server situs.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const message = [
        'Permintaan konsultasi Riksa Uji / K3',
        'Nama: ' + String(formData.get('name') || ''),
        'Perusahaan: ' + String(formData.get('company') || ''),
        'Nomor kontak: ' + String(formData.get('phone') || ''),
        'Layanan: ' + String(formData.get('service') || ''),
        'Detail kebutuhan: ' + String(formData.get('message') || ''),
      ].join(String.fromCharCode(10));
      const phone = form.dataset.whatsapp;
      if (phone) window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(message), '_blank', 'noopener,noreferrer');
    });
  });
</script>
