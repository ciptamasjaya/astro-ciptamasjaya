---
import { site } from '../../config';

interface ContactNumber {
  label: string;
  phone: string;
  display: string;
}
interface Props {
  id: string;
  title: string;
  intro: string;
  contacts: ContactNumber[];
  whatsapp?: string;
  hoursTitle: string;
  hours: string[];
  formTitle: string;
  serviceOptions: string[];
}
const { id, title, intro, contacts, whatsapp = site.whatsapp, hoursTitle, hours, formTitle, serviceOptions } = Astro.props;
const titleId = `${id}-title`;
const formId = `${id}-form`;
---
<section id={id} class="mt-8" aria-labelledby={titleId}>
  <header class="relative overflow-hidden rounded-3xl bg-slate-950 px-6 py-9 text-white sm:px-9 sm:py-12 lg:px-12">
    <div class="absolute -right-12 -top-16 h-56 w-56 rounded-full bg-blue-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-3xl">
      <p class="mb-4 inline-flex items-center rounded-full border border-blue-300/30 bg-blue-400/10 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-blue-200">Hubungi Cipta Mas Jaya</p>
      <h1 id={titleId} class="max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8">{intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
          Chat WhatsApp <span aria-hidden="true" class="ml-2">↗</span>
        </a>
      </div>
    </div>
  </header>

  <div class="mt-7 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-8">
    <div class="space-y-6">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby={`${id}-contact-details`}>
        <h2 id={`${id}-contact-details`} class="text-xl font-bold tracking-tight text-slate-950">Saluran komunikasi</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Pilih cara yang paling nyaman untuk menghubungi tim kami.</p>
        <div class="mt-5 space-y-3">
          {contacts.map((contact) => {
            const isLandline = contact.label.toLowerCase().includes('telepon');
            const href = isLandline ? `tel:${contact.phone}` : `https://wa.me/${contact.phone}`;
            return (
              <a href={href} target={isLandline ? undefined : '_blank'} rel={isLandline ? undefined : 'noopener noreferrer'} class="group flex items-start gap-4 rounded-xl border border-slate-200 p-4 transition hover:border-blue-300 hover:bg-blue-50/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-lg font-bold text-blue-700" aria-hidden="true">{isLandline ? '☎' : 'WA'}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-600">{contact.label}</span>
                  <span class="mt-1 block break-words font-bold text-slate-950 group-hover:text-blue-800">{contact.display}</span>
                  <span class="mt-1 block text-xs text-slate-500">{isLandline ? 'Hubungi melalui telepon' : 'Buka percakapan WhatsApp'} <span aria-hidden="true">↗</span></span>
                </span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-7" aria-labelledby={`${id}-hours`}>
        <div class="flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-blue-700 ring-1 ring-slate-200" aria-hidden="true">◷</span>
          <div>
            <h2 id={`${id}-hours`} class="text-lg font-bold text-slate-950">{hoursTitle}</h2>
            <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
              {hours.map((hour) => <li>{hour}</li>)}
            </ul>
          </div>
        </div>
      </section>
    </div>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 lg:p-8" aria-labelledby={`${id}-form-heading`}>
      <div class="border-b border-slate-200 pb-5">
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-blue-700">Permintaan konsultasi</p>
        <h2 id={`${id}-form-heading`} class="mt-2 text-2xl font-extrabold tracking-tight text-slate-950">{formTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Isi detail berikut agar tim kami dapat memahami kebutuhan K3 Anda.</p>
      </div>
      <form id={formId} data-contact-form data-whatsapp={whatsapp} class="mt-6 space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${formId}-name`} class="mb-2 block text-sm font-semibold text-slate-800">Nama lengkap <span class="text-red-600" aria-hidden="true">*</span></label>
            <input id={`${formId}-name`} name="name" type="text" autocomplete="name" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-950 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20" placeholder="Nama Anda" />
          </div>
          <div>
            <label for={`${formId}-company`} class="mb-2 block text-sm font-semibold text-slate-800">Nama perusahaan <span class="text-red-600" aria-hidden="true">*</span></label>
            <input id={`${formId}-company`} name="company" type="text" autocomplete="organization" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-950 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20" placeholder="Nama perusahaan" />
          </div>
        </div>
        <div>
          <label for={`${formId}-phone`} class="mb-2 block text-sm font-semibold text-slate-800">Nomor WhatsApp / telepon <span class="text-red-600" aria-hidden="true">*</span></label>
          <input id={`${formId}-phone`} name="phone" type="tel" autocomplete="tel" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-950 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20" placeholder="08xxxxxxxxxx" />
        </div>
        <div>
          <label for={`${formId}-service`} class="mb-2 block text-sm font-semibold text-slate-800">Layanan yang dibutuhkan <span class="text-red-600" aria-hidden="true">*</span></label>
          <select id={`${formId}-service`} name="service" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-950 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20">
            <option value="" disabled selected>Pilih layanan</option>
            {serviceOptions.map((service) => <option value={service}>{service}</option>)}
          </select>
        </div>
        <div>
          <label for={`${formId}-message`} class="mb-2 block text-sm font-semibold text-slate-800">Detail kebutuhan</label>
          <textarea id={`${formId}-message`} name="message" rows="4" class="w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-base leading-6 text-slate-950 placeholder:text-slate-400 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-600/20" placeholder="Ceritakan jenis peralatan, lokasi, atau kebutuhan inspeksi Anda..."></textarea>
        </div>
        <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-blue-700 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">
          Siapkan pesan di WhatsApp <span aria-hidden="true" class="ml-2">→</span>
        </button>
        <p class="text-xs leading-5 text-slate-500">Data formulir tidak dikirim ke server situs. Setelah tombol ditekan, pesan akan disiapkan di WhatsApp agar dapat Anda tinjau sebelum dikirim.</p>
      </form>
    </section>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const message = [
        'Permintaan konsultasi Riksa Uji / K3',
        'Nama: ' + String(formData.get('name') || ''),
        'Perusahaan: ' + String(formData.get('company') || ''),
        'Nomor kontak: ' + String(formData.get('phone') || ''),
        'Layanan: ' + String(formData.get('service') || ''),
        'Detail kebutuhan: ' + String(formData.get('message') || ''),
      ].join(String.fromCharCode(10));
      const phone = form.dataset.whatsapp;
      if (phone) window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(message), '_blank', 'noopener,noreferrer');
    });
  });
</script>
