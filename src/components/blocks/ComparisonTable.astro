---
interface Props { id: string; title: string; intro?: string; headers: string[]; rows: string[][]; note?: string }
const { id, title, intro, headers, rows, note } = Astro.props;
---
<section id={id} class="my-10" aria-labelledby={`${id}-title`}><h2 id={`${id}-title`} class="text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>{intro && <p class="mt-3 max-w-3xl leading-7 text-slate-600">{intro}</p>}<div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 shadow-sm"><table class="w-full min-w-[34rem] border-collapse text-left text-sm"><thead class="bg-slate-900 text-white"><tr>{headers.map((header) => <th scope="col" class="px-5 py-4 font-bold">{header}</th>)}</tr></thead><tbody>{rows.map((row, index) => <tr class={index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>{row.map((cell) => <td class="border-t border-slate-200 px-5 py-4 align-top leading-6 text-slate-700">{cell}</td>)}</tr>)}</tbody></table></div>{note && <p class="mt-3 text-sm leading-6 text-slate-500">{note}</p>}</section>