---
import { site } from '../../config';

interface Props {
  id: string;
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  secondaryIsWhatsApp?: boolean;
}
const { id, title, description, primaryLabel, primaryHref, secondaryLabel, secondaryHref, secondaryIsWhatsApp = false } = Astro.props;
const titleId = `${id}-title`;
const resolvedSecondaryHref = secondaryIsWhatsApp ? `https://wa.me/${site.whatsapp}` : secondaryHref;
---
<section id={id} class="py-16 bg-white hero-section" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 hero-container">
    <header class="hero-header text-center mb-12">
      <h1 id={titleId} class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">{title}</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{description}</p>
    </header>
    <div class="hero-actions mt-10 flex flex-col sm:flex-row justify-center gap-4 sm:gap-6">
      <a href={primaryHref} class="px-6 py-3 bg-primary-600 text-white font-medium rounded-lg shadow-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-primary-500">
        {primaryLabel}
      </a>
      <a href={resolvedSecondaryHref} class="px-6 py-3 bg-green-600 text-white font-medium rounded-lg shadow-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white focus:ring-green-500">
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
