---
interface Item { label: string; detail?: string; required?: boolean }
interface Props { id: string; title: string; description?: string; items: Item[]; note?: string }
const { id, title, description, items, note } = Astro.props;
---
<section id={id} class="my-10 rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby={`${id}-title`}><div class="mb-5 flex items-start gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-lg text-emerald-800" aria-hidden="true">✓</span><div><h2 id={`${id}-title`} class="text-xl font-extrabold text-slate-950 sm:text-2xl">{title}</h2>{description && <p class="mt-2 leading-7 text-slate-600">{description}</p>}</div></div><ul class="divide-y divide-slate-100">{items.map((item) => <li class="flex gap-3 py-4"><span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded border border-emerald-300 text-xs text-emerald-700" aria-hidden="true">✓</span><div class="flex-1"><p class="font-semibold text-slate-800">{item.label}</p>{item.detail && <p class="mt-1 text-sm leading-6 text-slate-600">{item.detail}</p>}</div>{item.required && <span class="shrink-0 text-xs font-semibold text-emerald-800">Prioritas</span>}</li>)}</ul>{note && <p class="mt-4 rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-600">{note}</p>}</section>