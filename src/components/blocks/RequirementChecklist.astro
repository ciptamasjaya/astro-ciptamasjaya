---
interface Item { label: string; required?: boolean }
interface Props { id: string; title: string; description?: string; items: Item[]; disclaimer?: string }
const { id, title, description, items, disclaimer } = Astro.props;
const titleId = `${id}-title`;
---
<section id={id} class="my-10 rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-7" aria-labelledby={titleId}>
  <h2 id={titleId} class="mb-2 text-2xl font-bold text-gray-900">{title}</h2>
  {description && <p class="mb-5 leading-7 text-gray-600">{description}</p>}
  <ul class="space-y-3">{items.map((item) => (<li class="flex items-start gap-3"><span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded border border-primary-300 bg-primary-50 text-primary-700" aria-hidden="true">✓</span><span class="flex-1 leading-6 text-gray-700">{item.label}</span>{item.required && <span class="shrink-0 text-xs text-gray-500">Prioritas</span>}</li>))}</ul>
  {disclaimer && <p class="mt-5 border-t border-gray-100 pt-4 text-sm leading-6 text-gray-500">{disclaimer}</p>}
</section>
