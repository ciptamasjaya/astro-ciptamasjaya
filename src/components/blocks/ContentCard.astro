---
interface Props { id: string; title: string; description?: string; items?: string[]; variant?: 'blue' | 'slate' | 'white' }
const { id, title, description, items = [], variant = 'white' } = Astro.props;
const styles = { blue: 'border-blue-200 bg-blue-50/70', slate: 'border-slate-200 bg-slate-50', white: 'border-slate-200 bg-white' };
---
<section id={id} class={`my-6 rounded-2xl border p-5 shadow-sm sm:p-7 ${styles[variant]}`} aria-labelledby={`${id}-title`}><h3 id={`${id}-title`} class="text-lg font-bold leading-snug text-slate-950 sm:text-xl">{title}</h3>{description && <p class="mt-3 leading-7 text-slate-700">{description}</p>}{items.length > 0 && <ul class="mt-4 space-y-3">{items.map((item) => <li class="flex gap-3 leading-7 text-slate-700"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-blue-600" aria-hidden="true"></span><span>{item}</span></li>)}</ul>}</section>