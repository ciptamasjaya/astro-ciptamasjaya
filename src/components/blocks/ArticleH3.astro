---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<h3 id={id} class="scroll-mt-28 mb-3 flex items-start gap-3 text-lg font-bold leading-snug text-slate-900 sm:text-xl">
  <span class="mt-[0.62em] h-2 w-2 shrink-0 rounded-sm bg-blue-600" aria-hidden="true"></span>
  <span>{title}</span>
</h3>
