---
interface Props { id: string; title: string; description: string; label: string; href: string; note?: string }
const { id, title, description, label, href, note } = Astro.props;
---
<aside id={id} class="my-12 overflow-hidden rounded-3xl bg-slate-950 px-6 py-8 text-white sm:px-9 sm:py-10"><div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center"><div class="max-w-2xl"><p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-blue-300">Butuh bantuan?</p><h2 class="text-2xl font-extrabold leading-tight sm:text-3xl">{title}</h2><p class="mt-3 leading-7 text-slate-300">{description}</p>{note && <p class="mt-3 text-sm leading-6 text-slate-400">{note}</p>}</div><a href={href} class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-400 px-5 py-3 font-bold text-slate-950 transition hover:bg-blue-300 focus:outline-none focus:ring-2 focus:ring-white">{label}<span class="ml-2" aria-hidden="true">→</span></a></div></aside>