---
const { items = [] } = Astro.props as { items?: { label: string; href?: string }[] };
---
<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href="/" class="hover:text-blue-700">Beranda</a></li>
    {items.map((item, index) => <li class="flex items-center gap-2"><span aria-hidden="true">/</span>{item.href && index < items.length - 1 ? <a href={item.href} class="hover:text-blue-700">{item.label}</a> : <span aria-current="page" class="text-slate-700">{item.label}</span>}</li>)}
  </ol>
</nav>
