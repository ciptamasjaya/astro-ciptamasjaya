---
import { site, services } from '../../config';
---
<footer class="mt-20 bg-slate-950 text-slate-300">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-12 md:grid-cols-4">
    <div>
      <a href="/" class="text-lg font-bold text-white">PT. Cipta <span class="text-blue-400">Mas Jaya</span></a>
      <p class="mt-3 max-w-sm text-sm leading-6">
        PJK3 Riksa Uji — jasa inspeksi K3 untuk pesawat angkat dan angkut, pesawat uap dan bejana tekan, proteksi kebakaran, instalasi listrik, penyalur petir, serta elevator dan eskalator.
      </p>
    </div>
    <div>
      <h2 class="font-semibold text-white">Layanan Riksa Uji</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {services.map((s) => (
          <li><a href={`/${s.path}/`} class="hover:text-white">{s.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-semibold text-white">Navigasi</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="hover:text-white">Beranda</a></li>
        <li><a href="/layanan/" class="hover:text-white">Layanan</a></li>
        <li><a href="/tanya-jawab/" class="hover:text-white">Tanya Jawab</a></li>
        <li><a href="/blog/" class="hover:text-white">Blog</a></li>
        <li><a href="/about/" class="hover:text-white">Tentang Kami</a></li>
        <li><a href="/contact/" class="hover:text-white">Kontak</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-semibold text-white">Kontak</h2>
      <p class="mt-3 text-sm leading-6">
        {site.address.street}<br />
        {site.address.locality}, {site.address.region} {site.address.postalCode}
      </p>
      <p class="mt-3 text-sm leading-6">
        Telp: <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="text-blue-400 hover:underline">{site.phone}</a><br />
        HP/WA: <a href={`https://wa.me/${site.whatsapp}`} class="text-blue-400 hover:underline">{site.phoneMobile}</a><br />
        Email: <a href={`mailto:${site.email}`} class="text-blue-400 hover:underline">{site.email}</a>
      </p>
      <p class="mt-3 text-sm text-slate-400">
        Sen &ndash; Jum: 09.00 &ndash; 18.00 WIB<br />Sab &ndash; Ming: Tutup
      </p>
    </div>
  </div>
  <div class="border-t border-white/10 px-5 py-4 text-center text-xs">
    &copy; {new Date().getFullYear()} {site.name}. Hak cipta dilindungi. PJK3 Riksa Uji terdaftar Kemnaker RI.
  </div>
</footer>
