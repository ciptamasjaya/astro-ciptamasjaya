---
import { site } from '../../config';
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/layanan/', label: 'Layanan' },
  { href: '/tanya-jawab/', label: 'Tanya Jawab' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'Tentang Kami' },
];
---
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4">
    <a href="/" class="text-lg font-extrabold tracking-tight text-slate-950" aria-label={`${site.name} — Beranda`}>
      Cipta<span class="text-blue-700">MasJaya</span>
    </a>
    <nav aria-label="Navigasi utama" class="hidden items-center gap-6 md:flex">
      {nav.map((item) => (
        <a class="text-sm font-medium text-slate-600 hover:text-blue-700" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a
        href={`https://wa.me/${site.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700"
      >
        WhatsApp
      </a>
      <a href="/contact/" class="rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-800">Konsultasi</a>
    </div>
    <button
      class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 md:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-5 py-4 md:hidden">
    <nav aria-label="Navigasi mobile" class="flex flex-col gap-3">
      {nav.map((item) => (
        <a class="text-sm font-medium text-slate-600 hover:text-blue-700" href={item.href}>{item.label}</a>
      ))}
      <div class="mt-2 flex flex-col gap-2 border-t border-slate-200 pt-4">
        <a
          href={`https://wa.me/${site.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-emerald-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-emerald-700"
        >
          WhatsApp
        </a>
        <a href="/contact/" class="rounded-lg bg-blue-700 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-blue-800">Konsultasi</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('button[aria-controls="mobile-menu"]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
  }
</script>
