---
import type { CollectionEntry } from 'astro:content';
const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const d = article.data;
const d2 = (n: number) => String(n).padStart(2, '0');
const href = d.pubDate ? `/${d.pubDate.getUTCFullYear()}/${d2(d.pubDate.getUTCMonth() + 1)}/${d2(d.pubDate.getUTCDate())}/${article.data.slug}/` : '/';
const productionOrigin = 'https://www.ciptamasjaya.co.id';
const imageUrl = d.image
  ? (() => {
      try {
        const url = new URL(d.image, productionOrigin);
        if (['ciptamasjaya.co.id', 'www.ciptamasjaya.co.id'].includes(url.hostname.toLowerCase())) {
          url.protocol = 'https:';
          url.hostname = 'www.ciptamasjaya.co.id';
        }
        return url.toString();
      } catch {
        return undefined;
      }
    })()
  : undefined;
---
<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg">
  {imageUrl && <div class="article-card__media overflow-hidden rounded-xl"><img src={imageUrl} alt="" class="h-40 w-full object-cover" loading="lazy" /></div>}
  {article.data.category && <p class="mt-4 text-xs font-bold uppercase tracking-wider text-blue-700">{article.data.category}</p>}
  <h3 class="mt-3 text-lg font-bold leading-snug text-slate-950"><a href={href} class="hover:text-blue-700">{article.data.title}</a></h3>
  <p class="mt-3 flex-1 text-sm leading-6 text-slate-600">{article.data.description}</p>
  <div class="mt-5 flex items-center justify-between text-xs text-slate-500"><time datetime={d.pubDate.toISOString()}>{d.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time><a href={href} class="font-semibold text-blue-700">Baca artikel →</a></div>
</article>
