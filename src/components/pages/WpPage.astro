/** Renderer halaman WP generik. Halaman layanan utama memakai layout landing page full-width. */
import PageShell from '../shared/PageShell.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import ArticleSidebar from '../shared/ArticleSidebar.astro';
import RelatedArticles from '../shared/RelatedArticles.astro';
import BlockRenderer from '../blocks/BlockRenderer.astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { breadcrumbSchema, serviceSchema } from '../../utils/structured-data';
import { site } from '../../config';

const { page, service = null, extraSchemas = [], articles = [], showRelatedArticles = false } = Astro.props as {
  page: CollectionEntry<'pages'>;
  service?: { title: string; description: string; href: string } | null;
  extraSchemas?: object[];
  articles?: CollectionEntry<'articles'>[];
  showRelatedArticles?: boolean;
};

const d = page.data;
const { Content, headings } = await render(page);
const pathNorm = d.path.replace(/^\/+|\/+$/g, '');
const isServiceLanding = pathNorm === 'layanan';
const crumbs: { label: string; href?: string }[] = pathNorm
  ? pathNorm.split('/').map((part, i, arr) => ({
      label: i === arr.length - 1 ? d.title : part.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
      href: i === arr.length - 1 ? undefined : `/${arr.slice(0, i + 1).join('/')}/`,
    }))
  : [{ label: d.title }];
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = pathNorm ? `/${pathNorm}/` : '/';
const schemas: object[] = [
  breadcrumbSchema([{ label: 'Beranda', href: '/' }, ...crumbs.filter((c) => c.href).map((c) => ({ label: c.label, href: c.href! })), { label: d.title }], baseUrl),
  ...extraSchemas,
];
if (pathNorm.startsWith('layanan')) {
  schemas.push(serviceSchema({ title: d.title, description: d.description, url: new URL(canonical, baseUrl).toString(), siteName: 'PT. Cipta Mas Jaya' }));
}
---
<PageShell title={`${d.title} | PT. Cipta Mas Jaya`} description={d.description} canonical={canonical} image={d.image}>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  {isServiceLanding ? (
    <div class="min-h-screen bg-white">
      <div class="mx-auto max-w-7xl px-5 pt-5 sm:px-8"><Breadcrumbs items={crumbs} /></div>
      <section class="relative isolate mt-5 overflow-hidden bg-slate-950 text-white">
        <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/70 via-slate-950 to-slate-950"></div>
        <div aria-hidden="true" class="absolute -right-24 -top-28 h-96 w-96 rounded-full border-[48px] border-white/[0.04]"></div>
        <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:gap-16 lg:py-24">
          <div>
            <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-200"><span class="h-2 w-2 rounded-full bg-emerald-400"></span> Mitra PJK3 Riksa Uji Anda</p>
            <h1 class="max-w-4xl text-4xl font-black leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">{d.title}<span class="text-blue-400">.</span></h1>
            <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">{d.description}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#kategori-layanan" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-500 px-6 py-3 font-bold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Jelajahi layanan <span class="ml-2" aria-hidden="true">↓</span></a>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/20 bg-white/5 px-6 py-3 font-bold text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Konsultasi kebutuhan K3 <span class="ml-2" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 lg:pb-2">
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur"><p class="text-3xl font-black text-white">K3</p><p class="mt-2 text-sm leading-5 text-slate-300">Keselamatan dan kesehatan kerja</p></div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur"><p class="text-3xl font-black text-white">PJK3</p><p class="mt-2 text-sm leading-5 text-slate-300">Layanan riksa uji untuk kebutuhan industri</p></div>
            <div class="col-span-2 rounded-2xl border border-blue-300/20 bg-blue-500/10 p-5"><p class="text-sm font-bold text-blue-200">Dari pemeriksaan hingga pengesahan gambar</p><p class="mt-2 text-sm leading-6 text-slate-300">Temukan kategori layanan yang sesuai dengan peralatan, instalasi, dan fasilitas kerja Anda.</p></div>
          </div>
        </div>
      </section>
      <main class="mx-auto max-w-[1440px] px-0 sm:px-3 lg:px-6">
        {d.blocks?.length ? <BlockRenderer blocks={d.blocks} pageMetadata={{ title: d.title, description: d.description, image: d.image }} /> : <article class="prose-content mx-auto max-w-4xl px-5 py-10"><Content /></article>}
      </main>
      {showRelatedArticles && <div class="mx-auto max-w-7xl px-5 sm:px-8"><RelatedArticles articles={articles} category={d.category} heading="Artikel Layanan Terkait" /></div>}
    </div>
  ) : (
    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 md:py-12">
      <Breadcrumbs items={crumbs} />
      <div class="mt-7 grid grid-cols-12 gap-8 lg:gap-12">
        <aside class="col-span-12 hidden lg:col-span-3 lg:block" aria-label="Navigasi dan informasi pendukung halaman">
          <div class="sticky top-28 rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="mb-4 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-700">Di halaman ini</p>
            <ArticleSidebar headings={headings.filter((h) => h.depth === 2 || h.depth === 3)} service={service} />
          </div>
        </aside>
        <div class="col-span-12 min-w-0 lg:col-span-9">
          <article class="mx-auto max-w-4xl">
            <header class="mb-9 border-b border-slate-200 pb-8">
              {service && <p class="mb-4 inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-blue-800">Layanan K3 · Cipta Mas Jaya</p>}
              <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl md:text-5xl">{d.title}</h1>
              {d.description && <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 md:text-xl">{d.description}</p>}
              {service && <div class="mt-6 flex flex-wrap gap-3">
                <a href={service.href} class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Lihat cakupan layanan <span aria-hidden="true" class="ml-2">→</span></a>
                <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 transition hover:border-emerald-500 hover:text-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">Konsultasi WhatsApp</a>
              </div>}
            </header>
            {d.image && <img src={d.image} alt={d.title} class="mb-9 aspect-[16/7] w-full rounded-2xl border border-slate-200 object-cover shadow-sm" loading="eager" />}
            {d.blocks?.length ? <div class="mt-10"><BlockRenderer blocks={d.blocks} pageMetadata={{ title: d.title, description: d.description, image: d.image }} /></div> : <div class="prose-content max-w-none"><Content /></div>}
          </article>
          {showRelatedArticles && <div class="mt-12 border-t border-slate-200 pt-8"><RelatedArticles articles={articles} category={d.category} heading="Artikel Layanan Terkait" /></div>}
        </div>
      </div>
    </div>
  )}
</PageShell>