---
/**
 * Layout artikel WP (URL dated): sidebar TOC/layanan/penulis + konten markdown
 * + block opsional + related articles algoritma 3-tier + JSON-LD.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import ArticleSidebar from '../shared/ArticleSidebar.astro';
import RelatedArticles from '../shared/RelatedArticles.astro';
import LatestArticles from '../blocks/LatestArticles.astro';
import BlockRenderer from '../blocks/BlockRenderer.astro';
import { site, getServiceById } from '../../config';
import { render, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../../utils/structured-data';

const {
  article,
  articles = [],
  headings = [],
  authorName,
  categoryHref = '/blog/',
  categoryLabel = 'Artikel',
} = Astro.props as {
  article: CollectionEntry<'articles'>;
  articles?: CollectionEntry<'articles'>[];
  headings?: MarkdownHeading[];
  authorName?: string;
  categoryHref?: string;
  categoryLabel?: string;
};

const { Content } = await render(article);
const d = article.data;
const p2 = (n: number) => String(n).padStart(2, '0');
const postHref = `/${d.pubDate.getUTCFullYear()}/${p2(d.pubDate.getUTCMonth() + 1)}/${p2(d.pubDate.getUTCDate())}/${d.slug}/`;
const service = getServiceById(d.relatedService);
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.toString().replace(/\/\d{4}\/.*$/, '');
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const schemas = [
  articleSchema({
    title: d.title,
    description: d.description,
    pubDate: d.pubDate,
    updatedDate: d.updatedDate,
    image: d.image,
    url: new URL(postHref, baseUrl).toString(),
    authorName: authorName ?? d.author,
    siteName: site.name,
  }),
  breadcrumbSchema([{ label: 'Beranda', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: d.title }], baseUrl),
];

const faqItems = (d.blocks ?? []).flatMap((b) => (b.type === 'faq' && b.data.items) ? b.data.items : []);
const updatedArticles = articles
  .filter((entry) => !entry.data.draft && entry.data.slug !== d.slug)
  .sort((a, b) =>
    (b.data.updatedDate ?? b.data.pubDate).getTime() -
    (a.data.updatedDate ?? a.data.pubDate).getTime()
  )
  .slice(0, 3);
---
<ArticleLayout title={d.title} description={d.description} canonical={postHref} image={d.image}>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {faqItems.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema(faqItems))} />}
  </Fragment>
  <div class="mx-auto max-w-7xl px-5 py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: d.title }]} />
    <div class="article-layout mt-6 grid grid-cols-12 gap-8">
      <aside class="article-layout__sidebar col-span-12 hidden lg:col-span-3 lg:block" aria-label="Informasi pendukung artikel">
        <div class="sticky top-8">
          <ArticleSidebar
            headings={toc}
            service={service ? { title: service.title, description: service.description, href: service.href } : null}
            authorName={authorName ?? d.author}
            category={{ label: categoryLabel, href: categoryHref }}
          />
        </div>
      </aside>
      <div class="article-layout__main col-span-12 lg:col-span-9">
        <article class="mx-auto max-w-3xl">
          {d.category && <p class="text-sm font-bold uppercase tracking-wider text-blue-700">{categoryLabel}</p>}
          <h1 class="mt-3 text-4xl font-extrabold leading-tight tracking-tight text-slate-950 md:text-5xl">{d.title}</h1>
          <p class="mt-5 text-xl leading-8 text-slate-600">{d.description}</p>
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500">
            <span>{authorName ?? d.author ?? 'Tim Redaksi'}</span>
            <time datetime={d.pubDate.toISOString()}>{d.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            {d.updatedDate && <span>Diperbarui {d.updatedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>}
          </div>
          {d.image && <img src={d.image} alt={d.title} class="mt-8 w-full rounded-2xl object-cover" loading="eager" />}
          <div class="prose-content mt-10"><Content /></div>
          {d.blocks?.length ? <BlockRenderer blocks={d.blocks} pageMetadata={{ title: d.title, description: d.description, image: d.image }} /> : null}
          {d.tags.length > 0 && (
            <footer class="mt-12 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6">
              <span class="mr-2 text-sm font-medium text-slate-500">Tags:</span>
              {d.tags.map((tag: string) => <span class="rounded-md bg-slate-100 px-3 py-1 text-xs text-slate-700">#{tag}</span>)}
            </footer>
          )}
        </article>
        <RelatedArticles articles={articles} currentSlug={d.slug} category={d.category} relatedService={d.relatedService} relatedPage={d.relatedPage} />
        {updatedArticles.length > 0 && (
          <LatestArticles
            id="article-updated-content"
            articles={updatedArticles}
            title="Artikel Terbaru dan Diperbarui"
            dateMode="updated"
          />
        )}
      </div>
    </div>
  </div>
</ArticleLayout>
