---
/**
 * Layout artikel WP (URL dated): sidebar TOC/layanan/penulis + konten markdown
 * + block opsional + related articles algoritma 3-tier + JSON-LD.
 */
import PageLayout from './PageLayout.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';
import ArticleSidebar from '../components/shared/ArticleSidebar.astro';
import RelatedArticles from '../components/shared/RelatedArticles.astro';
import LatestArticles from '../components/blocks/LatestArticles.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { site, getServiceById } from '../config';
import { render, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../utils/structured-data';
import { isLocalSeoArticle } from '../utils/related';

const {
  article,
  articles = [],
  headings = [],
  authorName,
  categoryHref = '/blog/',
  categoryLabel = 'Artikel',
} = Astro.props as {
  article: CollectionEntry<'articles'>;
  articles?: CollectionEntry<'articles'>[];
  headings?: MarkdownHeading[];
  authorName?: string;
  categoryHref?: string;
  categoryLabel?: string;
};

const { Content, headings: renderedHeadings } = await render(article);
const d = article.data;
const p2 = (n: number) => String(n).padStart(2, '0');
const postHref = `/${d.pubDate.getUTCFullYear()}/${p2(d.pubDate.getUTCMonth() + 1)}/${p2(d.pubDate.getUTCDate())}/${d.slug}/`;
const service = getServiceById(d.relatedService);
const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.toString().replace(/\/\d{4}\/.*$/, '');
const blockHeadings = (d.blocks ?? [])
  .filter((block) => block.type === 'section-header')
  .map((block) => ({ depth: 2 as const, slug: block.id, text: block.data.title }));
const toc = [...(headings.length ? headings : renderedHeadings), ...blockHeadings]
  .filter((h) => h.depth === 2 || h.depth === 3);
const schemas = [
  articleSchema({
    title: d.title,
    description: d.description,
    pubDate: d.pubDate,
    updatedDate: d.updatedDate,
    image: d.image,
    url: new URL(postHref, baseUrl).toString(),
    authorName: authorName ?? d.author,
    siteName: site.name,
  }),
  breadcrumbSchema([{ label: 'Beranda', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: d.title }], baseUrl),
];

const faqItems = (d.blocks ?? []).flatMap((b) => (b.type === 'faq' && b.data.items) ? b.data.items : []);
const updatedArticles = articles
  .filter((entry) => !entry.data.draft && !isLocalSeoArticle(entry) && entry.data.slug !== d.slug)
  .sort((a, b) =>
    (b.data.updatedDate ?? b.data.pubDate).getTime() -
    (a.data.updatedDate ?? a.data.pubDate).getTime()
  )
  .slice(0, 3);
---
<PageLayout title={d.title} description={d.description} canonical={postHref} image={d.image}>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {faqItems.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema(faqItems))} />}
  </Fragment>
  <div class="mx-auto max-w-7xl px-5 py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog/' }, { label: d.title }]} />
    <div class="article-layout mt-6 grid grid-cols-12 gap-8">
      <aside class="article-layout__sidebar col-span-12 hidden lg:col-span-3 lg:block" aria-label="Informasi pendukung artikel">
        <div class="sticky top-8">
          <ArticleSidebar
            headings={toc}
            service={service ? { title: service.title, description: service.description, href: service.href } : null}
            authorName={authorName ?? d.author}
            category={{ label: categoryLabel, href: categoryHref }}
          />
        </div>
      </aside>
      <div class="article-layout__main col-span-12 min-w-0 lg:col-span-9">
        <article class="mx-auto max-w-3xl">
          <header class="border-b border-slate-200 pb-8">
            {d.category && <p class="inline-flex rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-blue-800">{categoryLabel}</p>}
            <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-950 sm:text-4xl md:text-5xl">{d.title}</h1>
            <p class="mt-5 text-lg leading-8 text-slate-600 sm:text-xl">{d.description}</p>
            <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500">
              <span class="font-semibold text-slate-700">{authorName ?? d.author ?? 'Tim Redaksi'}</span>
              <span class="hidden text-slate-300 sm:inline" aria-hidden="true">•</span>
              <span class="inline-flex items-center gap-2"><span aria-hidden="true">Terbit</span><time datetime={d.pubDate.toISOString()}>{d.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
              {d.updatedDate && <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Diperbarui <time datetime={d.updatedDate.toISOString()}>{d.updatedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>}
            </div>
          </header>
          {toc.length > 0 && (
            <details class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:hidden">
              <summary class="cursor-pointer list-none font-bold text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">Daftar isi artikel <span class="float-right text-blue-700" aria-hidden="true">＋</span></summary>
              <nav class="mt-4 border-t border-slate-200 pt-3" aria-label="Daftar isi artikel">
                <ul class="space-y-2 text-sm">
                  {toc.map((heading) => <li class={heading.depth === 3 ? 'pl-4' : ''}><a class="text-slate-700 hover:text-blue-700 hover:underline" href={`#${heading.slug}`}>{heading.text}</a></li>)}
                </ul>
              </nav>
            </details>
          )}
          {d.image && <img src={d.image} alt={d.title} class="mt-8 aspect-[16/9] w-full rounded-2xl border border-slate-200 object-cover shadow-sm" loading="eager" fetchpriority="high" />}
          <div class="prose-content mt-9 sm:mt-10"><Content /></div>
          {d.blocks?.length ? <div class="mt-10"><BlockRenderer blocks={d.blocks} pageMetadata={{ title: d.title, description: d.description, image: d.image }} /></div> : null}
          {d.tags.length > 0 && (
            <footer class="mt-12 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6">
              <span class="mr-2 text-sm font-medium text-slate-500">Topik:</span>
              {d.tags.map((tag: string) => <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700">#{tag}</span>)}
            </footer>
          )}
        </article>
      </div>
    </div>
    <RelatedArticles articles={articles} currentSlug={d.slug} category={d.category} relatedService={d.relatedService} relatedPage={d.relatedPage} />
    {updatedArticles.length > 0 && (
      <LatestArticles
        id="article-updated-content"
        articles={updatedArticles}
        title="Artikel yang Diperbarui"
        dateMode="updated"
      />
    )}
  </div>
</PageLayout>
