---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';

const { title, description, canonical, image } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={canonical} image={image}>
  <slot name="head" slot="head" />
  <SiteHeader />
  <main id="main-content">
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>
